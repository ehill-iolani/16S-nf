params {
    // tests/data/ holds the same small synthetic fixtures edna-ont-nf uses
    // for its own -profile test (structural sequences, not real 16S) --
    // reused here since this profile only needs to exercise pipeline
    // mechanics, not produce biologically meaningful taxonomy.
    input       = 'tests/data/samplesheet.csv'
    taxdb       = 'tests/data/test_refs.fasta'
    metadata    = 'tests/data/metadata.csv'
    min_len     = 100
    max_len     = 2000
    min_qual    = 10
    cluster_id  = 0.85
    min_cluster = 5
}
