manifest {
    name            = '16S-nf'
    description     = 'ONT 16S rRNA amplicon microbial community classification pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.3.0'
}

params {
    // see main.nf for the full param list / help text
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // where each module's container image is pulled from, read directly by the
    // modules' `container` directives (hence declared here). These defaults are
    // the upstream registries; the google_batch profile points both at the
    // project's own Artifact Registry mirror (scripts/mirror_images.sh) so a run
    // doesn't depend on quay.io / Docker Hub being reachable from every Batch VM
    container_registry = 'quay.io'
    dockerhub_registry = 'docker.io'

    // chopper filtering thresholds -- declared here (not as script-level
    // `params.x = value` in main.nf) so they're reliably set before any
    // included module reads them; profiles like `test` can still override.
    // Defaults are sized for full-length 16S (~1.2-1.8kb, e.g. 27F/1492R);
    // narrow these for a single V-region amplicon instead.
    min_len  = 1200
    max_len  = 1800
    min_qual = 10

    // read-length/Q-score summary before vs. after filtering (final_report/read_qc_summary.html)
    enable_read_stats = true

    // same reason: read directly inside the BUILD_REPORT module script,
    // so they must live here rather than in main.nf
    enable_medaka = false
    min_pident    = 90

    // same reason: read directly inside the BUILD_REPORT module script.
    // Applied to the merged cluster size, flag-only (nothing is dropped);
    // min_rel_abundance is a fraction of the sample's clustered reads, 0 = off
    min_abundance     = 20
    min_rel_abundance = 0

    // same reason: read directly inside the MERGE_CONSENSUS module script;
    // 0 skips the second (consensus-level) vsearch pass
    merge_id      = 0.97

    // same reason: read directly inside the VSEARCH_CLUSTER module script
    cluster_id  = 0.86
    min_cluster = 5

    // same reason: read directly inside the FETCH_TAXDB_SILVA/REFSEQ module
    // scripts' storeDir directive -- only relevant for --tax_db_source
    // silva138/refseq16s, where it caches the downloaded reference fasta so
    // it's fetched once and reused across runs instead of every time
    tax_db_cache = "${projectDir}/assets/tax_db_cache"
}

// Declared before `profiles` (not after) -- Nextflow's config merging
// replaces a `withLabel` selector wholesale for whichever declaration wins,
// it doesn't merge individual directives within it. A block declared later
// in the file wins regardless of profile, so this has to come first for the
// google_batch profile's own withLabel overrides below to actually apply
// instead of being silently shadowed by these defaults.
process {
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '16.GB'
        time   = '8.h'
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled  = false
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        // set process.queue / clusterOptions per institution HPC as needed
    }
    test {
        includeConfig 'conf/test.config'
    }
    google_batch {
        process.executor      = 'google-batch'
        // Retry when Batch never gave a usable exit code -- a failed image
        // pull, a lost VM or a hit time limit all arrive as Nextflow's "no
        // exit status" (Integer.MAX_VALUE, printed as "-") -- or reports a
        // Batch-level code (>= 50000, e.g. 50001 Spot preemption). A script
        // that really exited 1-255 is deterministic, so retrying only repeats
        // it: that fails at once.
        process.errorStrategy = {
            (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus >= 50000)
                ? 'retry' : 'terminate'
        }
        process.maxRetries    = 3
        // a closure so it still follows --dockerhub_registry when that's
        // overridden from the params file, after this profile is read
        process.container     = { "${params.dockerhub_registry}/library/ubuntu:22.04" }

        google.project        = 'iscc-400300'
        google.location       = 'us-central1'
        google.batch.spot     = true
        // pinned explicitly: Batch re-runs a Spot-preempted task up to this many
        // times itself, and Nextflow >= 24.10 changed the default to 0
        google.batch.maxSpotAttempts = 5

        // images come from our own mirror, not quay.io / Docker Hub (see the
        // params block); the mirror keeps each image's upstream path, so both
        // registries are one repo. Override with --container_registry quay.io
        // --dockerhub_registry docker.io to pull from upstream instead
        params.container_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'
        params.dockerhub_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'

        workDir               = 'gs://nextflow-jobs/16s/work'
        params.outdir         = 'gs://nextflow-jobs/16s/results'

        // FETCH_TAXDB_SILVA/REFSEQ's storeDir has to be a GCS path here, not
        // the base params block's local ${projectDir}-relative default:
        // those processes run remotely on a Google Batch VM, and the Batch
        // task handler rejects staging a storeDir publish to an arbitrary
        // local path on the machine that submitted the job ("Unexpected
        // path for Google Batch task handler: /root/.nextflow/assets/...").
        params.tax_db_cache   = 'gs://nextflow-jobs/16s/tax_db_cache'

        docker.enabled        = true

        // larger allotments than the base process block, scaling with
        // task.attempt so retries (see errorStrategy/maxRetries above)
        // get more room instead of repeatedly failing at the same size
        process {
            withLabel: process_low {
                cpus   = 4
                memory = { 8.GB  * task.attempt }
                time   = { 2.h   * task.attempt }
            }
            withLabel: process_medium {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
            withLabel: process_high {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }
        }
    }
}

timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
}
